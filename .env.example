# Say What? Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# App Settings
# ===================
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# ===================
# Storage
# ===================
DATABASE_URL=sqlite:///./say_what.db
CHROMA_DIR=./chroma_data

# ===================
# API Keys (for pre-loading demo content)
# Users will provide their own keys for processing their videos
# ===================

# Any one of these is enough (checked in this order).
# Used to seed demo videos and to answer chat on demo videos without a visitor key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ===================
# Whisper Settings (only if requirements-whisper.txt is installed)
# ===================
# Options: tiny, base, small, medium, large
WHISPER_MODEL=base

# ===================
# Chunking Settings
# ===================
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===================
# Rate Limiting
# ===================
MAX_EXTRACTIONS_PER_SESSION=5

# ===================
# Temp Directory
# ===================
TEMP_DIR=./temp
